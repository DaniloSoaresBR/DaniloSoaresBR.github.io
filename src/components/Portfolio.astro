---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { experience, profile, ui, type Locale } from '../data/content';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
// Foto opcional: basta colocar o arquivo em public/images/profile.jpg.
// Sem o arquivo, o hero mostra as iniciais.
const hasPhoto = existsSync(join(process.cwd(), 'public/images/profile.jpg'));
const initials = profile.name
	.split(' ')
	.filter((w) => /^[A-ZÀ-Ý]/.test(w))
	.map((w) => w[0])
	.slice(0, 2)
	.join('');
const homeHref = locale === 'en' ? '/' : '/pt/';
---

<Layout lang={locale} title={t.htmlTitle} description={t.description}>
	<header class="site-header">
		<div class="container bar">
			<a class="brand" href={homeHref}>{profile.name}</a>
			<nav>
				<a href="#sobre">{t.nav.about}</a>
				<a href="#experiencia">{t.nav.experience}</a>
				<a href="#habilidades">{t.nav.skills}</a>
				<a href="#contato">{t.nav.contact}</a>
				<a class="lang" href={t.switchHref} hreflang={locale === 'pt' ? 'en' : 'pt-BR'} lang={locale === 'pt' ? 'en' : 'pt-BR'}>{t.switchLabel}</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero container" id="inicio">
			<div class="hero-text">
				<p class="eyebrow">{t.hero.intro}</p>
				<h1>{profile.name}</h1>
				<p class="headline">{profile.headline}</p>
				<p class="lead">{t.hero.lead}</p>
				<p class="meta">{profile.location}</p>
				<a class="cta" href="#contato">{t.hero.cta} <span aria-hidden="true">→</span></a>
			</div>
			<div class="portrait" aria-hidden={hasPhoto ? undefined : 'true'}>
				{hasPhoto ? (
					<img src="/images/profile.jpg" alt={profile.name} width="400" height="400" />
				) : (
					<span class="initials">{initials}</span>
				)}
			</div>
		</section>

		<section class="container block" id="sobre">
			<header class="section-head">
				<span class="index">01</span>
				<h2>{t.about.title}</h2>
			</header>
			<div class="prose">
				{t.about.paragraphs.map((p) => <p>{p}</p>)}
			</div>
			<h3 class="sub">{t.about.educationTitle}</h3>
			<ul class="rows">
				{t.about.education.map((e) => (
					<li>
						<span>{e.title}</span>
						<span class="muted">{e.period}</span>
					</li>
				))}
			</ul>
		</section>

		<section class="container block" id="experiencia">
			<header class="section-head">
				<span class="index">02</span>
				<h2>{t.experience.title}</h2>
			</header>
			<ol class="timeline">
				{experience.map((job) => (
					<li>
						<div class="job-head">
							<h3>{job.role}</h3>
							<p class="company">{job.company}</p>
							<p class="muted small">{job.period[locale]} · {job.location}</p>
						</div>
						<div class="job-body">
							<p>{job.description[locale]}</p>
							<ul class="tags" aria-label="Stack">
								{job.stack.map((s) => <li>{s}</li>)}
							</ul>
						</div>
					</li>
				))}
			</ol>
		</section>

		<section class="container block" id="habilidades">
			<header class="section-head">
				<span class="index">03</span>
				<h2>{t.skills.title}</h2>
			</header>
			<div class="skill-grid">
				{t.skills.groups.map((g) => (
					<div>
						<h3 class="sub">{g.label}</h3>
						<ul class="tags">
							{g.items.map((i) => <li>{i}</li>)}
						</ul>
					</div>
				))}
			</div>
			<div class="two-col">
				<div>
					<h3 class="sub">{t.skills.certificationsTitle}</h3>
					<ul class="rows">
						{t.skills.certifications.map((c) => <li>{c}</li>)}
					</ul>
				</div>
				<div>
					<h3 class="sub">{t.skills.languagesTitle}</h3>
					<ul class="rows">
						{t.skills.languages.map((l) => <li>{l}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<section class="container block" id="contato">
			<header class="section-head">
				<span class="index">04</span>
				<h2>{t.contact.title}</h2>
			</header>
			<p class="lead">{t.contact.lead}</p>
			<ul class="contact-links">
				<li>
					<span class="muted">{t.contact.labels.email}</span>
					<a href={`mailto:${profile.email}`}>{profile.email}</a>
				</li>
				<li>
					<span class="muted">{t.contact.labels.linkedin}</span>
					<a href={profile.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/danilosoaresdasilva</a>
				</li>
				<li>
					<span class="muted">{t.contact.labels.github}</span>
					<a href={profile.github} target="_blank" rel="noopener noreferrer">github.com/DaniloSoaresBR</a>
				</li>
			</ul>
		</section>
	</main>

	<footer class="container footer muted small">
		<p>© {year} {profile.name}. {t.footer}</p>
	</footer>

	<style>
		.site-header {
			position: sticky;
			top: 0;
			z-index: 10;
			border-bottom: 1px solid var(--border);
			background: color-mix(in srgb, var(--bg) 85%, transparent);
			backdrop-filter: saturate(1.4) blur(10px);
			-webkit-backdrop-filter: saturate(1.4) blur(10px);
		}

		.bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem 1.5rem;
			padding-top: 0.9rem;
			padding-bottom: 0.9rem;
		}

		.brand {
			font-family: var(--serif);
			font-size: 1.05rem;
			color: var(--fg);
			text-decoration: none;
			letter-spacing: 0.01em;
		}

		nav {
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem 1.1rem;
			font-size: 0.9rem;
		}

		nav a {
			color: var(--muted);
			text-decoration: none;
		}

		nav a:hover {
			color: var(--fg);
		}

		nav .lang {
			color: var(--accent);
			border: 1px solid var(--border);
			border-radius: 999px;
			padding: 0.1rem 0.65rem;
		}

		.hero {
			display: grid;
			grid-template-columns: 1fr;
			gap: 2.5rem;
			align-items: center;
			padding-top: 5rem;
			padding-bottom: 4rem;
		}

		@media (min-width: 720px) {
			.hero {
				grid-template-columns: 1fr auto;
				gap: 4rem;
			}
		}

		.eyebrow {
			margin: 0 0 1rem;
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--accent);
		}

		h1 {
			margin: 0;
			font-family: var(--serif);
			font-weight: 500;
			font-size: clamp(2.4rem, 6vw, 3.6rem);
			line-height: 1.08;
			letter-spacing: -0.01em;
		}

		.headline {
			margin: 1rem 0 0;
			font-size: 0.98rem;
			color: var(--muted);
		}

		.lead {
			margin: 1.4rem 0 0;
			font-size: 1.12rem;
			max-width: 36ch;
		}

		.meta {
			margin: 0.9rem 0 0;
			font-size: 0.875rem;
			color: var(--muted);
		}

		.cta {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			margin-top: 1.8rem;
			padding: 0.6rem 1.15rem;
			border-radius: 999px;
			background: var(--accent);
			color: var(--bg);
			text-decoration: none;
			font-size: 0.95rem;
			font-weight: 500;
		}

		.cta:hover {
			opacity: 0.9;
		}

		.portrait {
			width: 200px;
			height: 200px;
			border-radius: 50%;
			overflow: hidden;
			margin: 0 auto;
			border: 1px solid var(--border);
			background: var(--accent-soft);
			display: grid;
			place-items: center;
		}

		@media (min-width: 720px) {
			.portrait {
				width: 260px;
				height: 260px;
			}
		}

		.portrait img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.initials {
			font-family: var(--serif);
			font-size: 3.6rem;
			color: var(--accent);
			letter-spacing: 0.04em;
		}

		.block {
			padding-top: 3.5rem;
			padding-bottom: 1rem;
		}

		.section-head {
			display: flex;
			align-items: baseline;
			gap: 0.9rem;
			border-top: 1px solid var(--border);
			padding-top: 1.5rem;
			margin-bottom: 1.6rem;
		}

		.index {
			font-size: 0.78rem;
			font-variant-numeric: tabular-nums;
			color: var(--accent);
			letter-spacing: 0.08em;
		}

		h2 {
			margin: 0;
			font-family: var(--serif);
			font-weight: 500;
			font-size: 1.7rem;
			letter-spacing: -0.005em;
		}

		h3 {
			margin: 0;
			font-size: 1rem;
			font-weight: 600;
		}

		.sub {
			margin: 2rem 0 0.9rem;
			font-size: 0.78rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--muted);
		}

		.prose p {
			margin: 0 0 1rem;
			max-width: 65ch;
		}

		.rows {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.rows li {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.25rem 1rem;
			padding: 0.7rem 0;
			border-bottom: 1px solid var(--border);
		}

		.timeline {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.timeline li {
			display: grid;
			gap: 0.9rem;
			padding: 1.6rem 0;
			border-bottom: 1px solid var(--border);
		}

		.timeline li:first-child {
			padding-top: 0.4rem;
		}

		@media (min-width: 720px) {
			.timeline li {
				grid-template-columns: 14rem 1fr;
				gap: 2rem;
			}
		}

		.company {
			margin: 0.15rem 0 0;
			color: var(--accent);
			font-weight: 500;
		}

		.job-head p {
			margin: 0.2rem 0 0;
		}

		.job-body p {
			margin: 0 0 0.9rem;
		}

		.tags {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}

		.tags li {
			font-size: 0.8rem;
			padding: 0.2rem 0.65rem;
			border-radius: 999px;
			background: var(--accent-soft);
			color: var(--accent);
		}

		.skill-grid {
			display: grid;
			gap: 0.5rem;
		}

		@media (min-width: 720px) {
			.skill-grid {
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}
		}

		.two-col {
			display: grid;
			gap: 0 2.5rem;
		}

		@media (min-width: 720px) {
			.two-col {
				grid-template-columns: 1fr 1fr;
			}
		}

		.contact-links {
			list-style: none;
			margin: 1.6rem 0 0;
			padding: 0;
			display: grid;
			gap: 0.9rem;
		}

		.contact-links li {
			display: flex;
			flex-direction: column;
			gap: 0.1rem;
		}

		.contact-links .muted {
			font-size: 0.78rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.contact-links a {
			font-size: 1.05rem;
		}

		.footer {
			margin-top: 4rem;
			padding-top: 2rem;
			padding-bottom: 3rem;
			border-top: 1px solid var(--border);
		}

		.muted {
			color: var(--muted);
		}

		.small {
			font-size: 0.875rem;
		}

		.footer p {
			margin: 0;
		}
	</style>
</Layout>
